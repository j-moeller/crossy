<!DOCTYPE html>
<head>
    <meta charset="utf-8">
    <title></title>
</head>
<body>
    <div>
        <%= input_filename %> <pre><code><%= input %></code></pre>
    </div>

    <ul>
        <% for (let i = 0; i < hashes.length; i++) { %>
            <li>
                <%= hashes[i].target %>:
                <pre><code data-target="<%= outputs[i].target %>"><%= outputs[i].chars %></code></pre>
            </li>
        <% } %>
    </ul>
</body>
</html>

