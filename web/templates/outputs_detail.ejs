<!DOCTYPE html>
<head>
    <meta charset="utf-8">
    <title></title>
</head>
<body>
    <h1><%= target_1 %> vs <%= target_2 %></h1>

    <div>
        <%= input_filename %> <pre><code><%= input %></code></pre>
    </div>
    <ul>
        <% for (let i = 0; i < outputs.length; i++) { %>
            <% if (outputs[i].target.startsWith(target_1)) { %>
                <li>
                    <pre><code data-target="<%= outputs[i].target %>"><%= outputs[i].chars %></code></pre>
                </li>
            <% } %>
        <% } %>

        <% for (let i = 0; i < outputs.length; i++) { %>
            <% if (outputs[i].target.startsWith(target_2)) { %>
                <li>
                    <pre><code data-target="<%= outputs[i].target %>"><%= outputs[i].chars %></code></pre>
                </li>
            <% } %>
        <% } %>
    </ul>
</body>
</html>

